# Google PageSpeed Insights API key. Optional: without it PSI still works on a
# very low shared quota. Get one at https://developers.google.com/speed/docs/insights/v5/get-started
# Enable the "PageSpeed Insights API" for the project, then use that project's key.
PSI_API_KEY=

# HTTP port for the local server.
PORT=3939

# How many PSI calls may be in flight at once (1-10). Quota cost is per run, not
# per concurrent call, so 10 finishes a 10-run report in one round. Drop to 2
# when running without PSI_API_KEY, whose shared quota rate-limits quickly.
PSI_CONCURRENCY=10
